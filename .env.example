EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional for deployed Expo web. Native Android/iOS always use doitright://auth/callback.
# EXPO_PUBLIC_WEB_AUTH_REDIRECT_URL=https://your-web-domain.example/auth/callback
# Optional local safety overrides. Leave unset to read provider status from Supabase.
# EXPO_PUBLIC_SUPABASE_EMAIL_ENABLED=true
# EXPO_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
